rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /tasks/{taskId} {
      function isOwner() {
        return request.auth != null && resource.data.userId == request.auth.uid;
      }

      function createsOwnTask() {
        return request.auth != null
          && request.resource.data.userId == request.auth.uid
          && request.resource.data.title is string
          && request.resource.data.description is string
          && request.resource.data.category in ['Tarefa', 'Aviso', 'Suporte']
          && request.resource.data.status in ['pendente', 'concluido'];
      }

      allow read: if isOwner();
      allow create: if createsOwnTask();
      allow update: if isOwner()
        && request.resource.data.userId == resource.data.userId
        && request.resource.data.category in ['Tarefa', 'Aviso', 'Suporte']
        && request.resource.data.status in ['pendente', 'concluido'];
      allow delete: if isOwner();
    }
  }
}
